# secrets - never commit
.env
*.pem
*.key
credentials.json
# your Meta targeting rules carry real audience ids — keep them local
meta_targeting_rules.json
*service-account*.json
certs/
# local state written at runtime: allowed_hosts.txt names your internal
# hostnames; the overrides file is per-deployment sample-limit state
allowed_hosts.txt
reacher_sample_limit_overrides.json

# local data - a warehouse DB is not source code
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# generated output
reports/
*.log
*_log.txt
*.zip

# environment / caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# editor / OS
.DS_Store
.idea/
.vscode/
