# ============================================================
#  API CREDENTIALS  —  copy this file to ".env" and fill in.
#  NEVER share or commit the real .env file. Keep it private.
#  IMPORTANT: keep empty keys COMMENT-FREE on their line —
#  python-dotenv can read an inline "# comment" as the value,
#  which defeats the skip-if-unconfigured check in run_sync.
# ============================================================

# ---------- Google Ads ----------
# OAuth "Desktop app" client in Google Cloud; run google_auth.py to mint the
# refresh token. LOGIN_CUSTOMER_ID = manager (MCC) account; CUSTOMER_ID = the
# ad account to pull. Both digits only.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# ---------- Meta (Facebook / Instagram) Ads ----------
# Long-lived system-user token. Account id looks like act_1234567890.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---------- Amazon Advertising ----------
# LWA app must have Ads API scope ASSIGNED (Advanced Tools Center; approval
# can take ~72h). Then amazon_auth.py --url -> consent -> amazon_auth.py <code>
# fills REFRESH_TOKEN and PROFILE_ID. REDIRECT_URI must BYTE-match an Allowed
# Return URL on the security profile — trailing slash matters.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
AMAZON_ADS_REGION=NA
AMAZON_ADS_REDIRECT_URI=

# ---------- Amazon retail orders (Selling Partner API) ----------
# Seller SELF-authorization: Seller Central > Apps & Services > Develop Apps >
# private app > "Authorize app" shows the refresh token directly.
# ATVPDKIKX0DER = US marketplace.
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_MARKETPLACE_ID=ATVPDKIKX0DER
SPAPI_REGION=NA

# ---------- Shopify (orders ground truth) ----------
# Dev Dashboard app (dev.shopify.com), Admin API scopes read_orders AND
# read_all_orders (without the latter: 60 days only), installed on the store.
# SHOPIFY_SHOP is the original *.myshopify.com slug, not the custom domain.
# SHOPIFY_ADMIN_TOKEN is only for legacy pre-2026 static shpat_ tokens.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=

# ---------- TikTok Shop ----------
# Partner Center app authorized with ALL scopes at once — a partial re-auth
# silently replaces the grant and orders fail with 105005 ~a week later.
# tiktok_auth.py <code> fills tokens + shop cipher/id.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=
TIKTOK_SHOP_ID=
TIKTOK_REFRESH_TOKEN=

# ---------- Google Analytics 4 (GA4 web analytics) — optional, ga4_sync.py ----------
# Service-account flow (server-to-server, no browser consent step): create/
# reuse a GCP service account, download its JSON key, enable the "Google
# Analytics Data API" for that project, then in GA4 Admin -> Property Access
# Management add the service account's email (looks like
# name@project.iam.gserviceaccount.com) as a Viewer.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_FILE=

# ---------- Google Merchant Center — optional, merchant_center_sync.py ----------
# Same kind of service-account credential as GA4 above (you can reuse the same
# JSON key if you enable the Content API scope for it). You must ALSO run a
# one-time registerGcp call before anything works — see the module docstring;
# there is no Merchant Center UI for that step.
GMC_MERCHANT_ID=
GMC_CREDENTIALS_FILE=

# ---------- Flexport (3PL fulfillment) — optional, flexport_*.py ----------
# Bearer token from the Flexport portal (Settings > API). One token is shared
# by all four Flexport scripts (flexport_sync.py, flexport_orders_sync.py,
# flexport_returns_sync.py, flexport_inbounds_sync.py) — they are standalone
# CLIs, not wired into run_sync.py, since they don't fit its ads/orders shape.
# Merchant tokens expire after about a year; a 401 means it needs rotating.
FLEXPORT_API_TOKEN=

# ---------- Klaviyo (email / SMS marketing) — optional, klaviyo_sync.py ----------
# Private API key from Klaviyo Settings > API Keys > Create Private API Key
# (scopes: campaigns:read, flows:read, metrics:read, segments:read).
KLAVIYO_API_KEY=
# Your account's conversion-event metric id (e.g. a "Placed Order" metric) -
# find it via GET /api/metrics or Klaviyo's Analytics > Metrics UI. No default;
# required for every report this connector pulls.
KLAVIYO_CONVERSION_METRIC=
# Optional overrides — sensible defaults if left blank.
KLAVIYO_API_REVISION=
KLAVIYO_CAMPAIGN_TIMEFRAME=
KLAVIYO_CAMPAIGN_META_LOOKBACK_DAYS=
KLAVIYO_TIMEZONE=

# ---------- Purple Dot (pre-order / waitlist platform) — optional, purple_dot_sync.py ----------
# Private API access token from the Purple Dot merchant portal's API Keys
# page. NOTE: this is the PRIVATE token, not the public client-side key — the
# public key will not authenticate this API.
PURPLE_DOT_ACCESS_TOKEN=

# ---------- Shopify customer dimension — optional, shopify_customers_sync.py ----------
# Reuses SHOPIFY_SHOP / SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET above — no
# new variable needed. It additionally requires the read_customers Admin API
# scope on that same app (a Shopify-side app configuration change, not an
# env var): add the scope, release a new version, reinstall the app.

# ---------- TikTok Shop video / live-shopping / creator analytics ----------
# optional, tiktok_videos_sync.py / tiktok_live_sync.py / tiktok_creators_sync.py
# All three reuse the TIKTOK_* credentials above — nothing new required.
# Optional overrides for tiktok_live_sync.py:
TIKTOK_LIVE_OWN_ACCOUNT_TYPE=OFFICIAL_ACCOUNTS
# account_type in tiktok_shop_lives that represents YOUR OWN broadcasts (vs
# affiliate/creator or paid-marketing lives). Change only if your shop labels
# its own live sessions differently.
TIKTOK_SHOP_TIMEZONE=UTC
# IANA timezone name (e.g. America/New_York) used to bucket live broadcasts
# into calendar days that match your business's own daily cutoff.

# ---------- Amazon Seller extras — optional, amazon_inventory/returns/rank/fees/economics_sync.py ----------
# All five reuse SPAPI_CLIENT_ID / SPAPI_CLIENT_SECRET / SPAPI_REFRESH_TOKEN /
# SPAPI_MARKETPLACE_ID / SPAPI_REGION above — no new variable needed.

# ---------- Team MCP server (server.py --http) ----------
# Any long random string; becomes part of the URL coworkers connect to. See
# SHARING.md for the full walkthrough of running this in shared/HTTP mode.
WAREHOUSE_MCP_TOKEN=
# Comma-separated extra Host/Origin values to accept in --http mode (a tunnel
# hostname, a hosts-file alias). Same list as allowed_hosts.txt; re-read live.
WAREHOUSE_MCP_ALLOWED_HOSTS=
